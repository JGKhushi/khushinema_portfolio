# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ───────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/khushi_portfolio
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/khushi_portfolio?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/khushi_portfolio

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Seeded admin account for the dashboard. Change the password before deploying.
ADMIN_EMAIL=khushinema22@gmail.com
ADMIN_PASSWORD=ChangeMe123!

# ── Client ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

# ── Email notifications (optional) ─────────────────────────────────────────
# When these are unset the contact form still works and saves to the database;
# you just won't get an email. Leave blank to disable.
#
# Gmail setup (one time):
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:     https://myaccount.google.com/apppasswords
#      (choose "Mail" → any device; Google shows a 16-character code)
#   3. Put that code in SMTP_PASS below — NOT your normal Gmail password.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=khushinema22@gmail.com
# ⚠ Replace the line below with the real 16-character code Google gives you.
# It is NOT your Gmail password, and NOT this placeholder text.
SMTP_PASS=REPLACE_WITH_REAL_APP_PASSWORD

# Where notifications are delivered (defaults to ADMIN_EMAIL if omitted).
MAIL_TO=khushinema22@gmail.com
